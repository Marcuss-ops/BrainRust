{
  "schema": "gold_multilingual.v1",
  "annotation": {
    "author": "agent-authored from linguistic judgment; NOT copied from engine output or from the filter/filler data",
    "entity_scheme": {
      "PERSON": "named human, full name surface as written in the text",
      "LOCATION": "named place (city), surface as written",
      "ORG": "named or definite institution mention (court, prosecutor's office, ministry); the annotation scheme treats a definite institution head in legal narration as an ORG mention, matching the engine's curated cue table",
      "WORK": "title of a creative work",
      "BRAND": "commercial brand",
      "PRODUCT": "named product line"
    },
    "scoring": {
      "unit": "entity per document (unique by surface), not mention-level",
      "types_scored": [
        "PERSON",
        "LOCATION",
        "ORG",
        "WORK",
        "BRAND",
        "PRODUCT"
      ],
      "excluded": "OBJECT / VISUAL_CONCEPT / DATE / NUMBER / MONEY / PERCENT / quotes: the certified contract is the named-entity set; the curated object slice (T05) is not scored",
      "match": "case-folded token-set containment between gold surface and extracted surface, type must agree",
      "thresholds": {
        "recall": 0.95,
        "typed_recall": 0.95,
        "precision": 0.98,
        "noise_leaks": 0
      },
      "noise_rules": {
        "filler": "no query may contain the filler phrase; no entity may contain it",
        "heading": "no query may contain the heading text; no entity may contain it",
        "pronoun": "no query and no entity may BE the bare pronoun (equality)"
      }
    },
    "language_notes": {
      "en": "English ships an empty legal-cue table, so the English scripts carry no institution mention; persons/places/works/brands/products only.",
      "pl": "Polish place surfaces are annotated in their dictionary form as they appear in the scripts; inflected place forms are outside the current place-index contract (documented limit).",
      "ru": "Same as Polish: scripts use nominative/indeclinable place surfaces (Москва, Казань)."
    }
  },
