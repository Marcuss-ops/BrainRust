{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Marcuss-ops/BrainRust/contract/mediaexec.v2/response.schema.json",
  "title": "mediaexec.v2 response (golden-certified envelope)",
  "description": "The success response envelope shared by the Rust executor and the Go rustexec consumer. The validator additionally requires operation equality with the request and ok=true for the golden set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "operation", "source_path", "items", "metadata", "error"],
  "properties": {
    "ok": { "type": "boolean" },
    "operation": { "type": "string", "minLength": 1 },
    "source_path": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/cut_item" }
    },
    "metadata": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/metadata" }]
    },
    "metrics": { "type": ["object", "null"] },
    "preflight": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/preflight_report" }]
    },
    "error": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "operation": { "const": "cut_batch" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "allOf": [
                {
                  "if": {
                    "properties": { "status": { "enum": ["succeeded", "validated"] } },
                    "required": ["status"]
                  },
                  "then": { "required": ["sha256"] }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "preflight_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "issues"],
      "properties": {
        "ok": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/definitions/preflight_issue" }
        }
      }
    },
    "preflight_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "detail"],
      "properties": {
        "severity": { "enum": ["error", "warning"] },
        "code": { "type": "string", "minLength": 1 },
        "item_id": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "detail": { "type": "string" }
      }
    },
    "cut_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "output_path", "status", "size_bytes", "duration_sec", "error"],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 },
        "output_path": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "duration_sec": { "type": "number", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "error": { "type": ["string", "null"] }
      }
    },
    "audio_edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_start_us",
        "source_end_us",
        "output_start_us",
        "output_end_us"
      ],
      "properties": {
        "source_start_us": { "type": "integer" },
        "source_end_us": { "type": "integer" },
        "output_start_us": { "type": "integer" },
        "output_end_us": { "type": "integer" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_sec",
        "width",
        "height",
        "fps",
        "video_codec",
        "audio_codec",
        "sample_rate",
        "channels",
        "has_video",
        "has_audio"
      ],
      "properties": {
        "duration_sec": { "type": "number", "minimum": 0 },
        "bitrate": { "type": ["integer", "null"] },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "fps": { "type": "number", "minimum": 0 },
        "video_codec": { "type": ["string", "null"] },
        "video_profile": { "type": "string" },
        "video_level": { "type": "string" },
        "pixel_format": { "type": ["string", "null"] },
        "video_time_base_num": { "type": "integer" },
        "video_time_base_den": { "type": "integer" },
        "sar_num": { "type": "integer" },
        "sar_den": { "type": "integer" },
        "color_range": { "type": "string" },
        "color_space": { "type": "string" },
        "color_transfer": { "type": "string" },
        "color_primaries": { "type": "string" },
        "field_order": { "type": "string" },
        "keyframe_interval": { "type": "integer", "minimum": 0 },
        "b_frames": { "type": "integer", "minimum": 0 },
        "closed_gop": { "type": "boolean" },
        "video_extradata_sha256": { "type": "string" },
        "format_name": { "type": "string" },
        "stream_count": { "type": "integer", "minimum": 0 },
        "video_stream_count": { "type": "integer", "minimum": 0 },
        "audio_stream_count": { "type": "integer", "minimum": 0 },
        "audio_edits": {
          "type": "array",
          "items": { "$ref": "#/definitions/audio_edit" }
        },
        "fps_num": { "type": "integer", "minimum": 0 },
        "fps_den": { "type": "integer", "minimum": 0 },
        "audio_codec": { "type": ["string", "null"] },
        "audio_profile": { "type": ["string", "null"] },
        "audio_time_base_num": { "type": "integer" },
        "audio_time_base_den": { "type": "integer" },
        "sample_rate": { "type": ["integer", "null"], "minimum": 0 },
        "channels": { "type": ["integer", "null"], "minimum": 0 },
        "channel_layout": { "type": "string" },
        "audio_bitrate": { "type": "integer" },
        "audio_extradata_sha256": { "type": "string" },
        "start_pts": { "type": ["integer", "null"] },
        "has_video": { "type": "boolean" },
        "has_audio": { "type": "boolean" },
        "prepare_ms": { "type": "integer", "minimum": 0 },
        "loudness_ms": { "type": "integer", "minimum": 0 },
        "mix_ms": { "type": "integer", "minimum": 0 },
        "aac_encode_ms": { "type": "integer", "minimum": 0 },
        "probe_ms": { "type": "integer", "minimum": 0 },
        "hash_ms": { "type": "integer", "minimum": 0 },
        "ffmpeg_ms": { "type": "integer", "minimum": 0 },
        "final_audio_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "audio_copy_eligible": { "type": "boolean" },
        "audio_encode_passes": { "type": "integer", "minimum": 0 },
        "decode_ms": { "type": "integer", "minimum": 0 },
        "encode_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
